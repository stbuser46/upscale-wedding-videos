# Large media & working artefacts — never in git
source/
work/
out/
models/
webui/data/assets/
webapp/data/
*.ISO
*.vob
*.VOB
*.mkv
*.mp4
*.flac

# Secrets — belt and braces; webapp/data/ is already ignored wholesale above
*.env
!.env.example
*_api_key
*apikey*
*api-key*
*api_key*
cloud/keys/

# Local tooling state (Claude Code settings + agent worktrees)
.claude/

# Runtime
*.log
*.partial
__pycache__/
*.pyc
.venv/
webapp/.venv/
node_modules/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Runtime-staged SeedVR2 tree for pod provisioning
docker/seedvr2-pod/_tree/
docker/seedvr2-pod/inductor_cache.tar
# Ephemeral per-job pod-to-pod ssh keypair (regenerated each fleet run)
docker/seedvr2-pod/_jobkey
docker/seedvr2-pod/_jobkey.pub
